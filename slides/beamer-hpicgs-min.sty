\setbeamercovered{transparent}

\mode<presentation>
\beamer@suppressreplacementstrue

\definecolor{CorporateBlue0}{cmyk}{0.9464,0.5968,0.2961,0.1462}
\definecolor{CorporateBlue1}{cmyk}{0.8584,0.4622,0.2444,0.0826}
\definecolor{CorporateBlue2}{cmyk}{0.7658,0.3269,0.1963,0.0425}
\definecolor{CorporateBlue3}{cmyk}{0.5218,0.0869,0.1018,0.0000}
\definecolor{CorporateBlue4}{cmyk}{0.3044,0.0000,0.0554,0.0000}

\setbeamercolor{postit}{fg=black,bg=white}

\setbeamercolor{title}{fg=CorporateBlue0}
\setbeamercolor{subtitle}{fg=CorporateBlue2}
\setbeamercolor{author}{fg=CorporateBlue2}
\setbeamercolor{institute}{fg=gray}
\setbeamercolor{frametitle}{fg=CorporateBlue1}
\setbeamercolor{footline}{fg=CorporateBlue2}

\setbeamercolor{normal text}{fg=black}

\setbeamerfont{title}{size=\Large}
\setbeamerfont{subtitle}{size=\normalsize}
\setbeamerfont{author}{size=\normalsize}
\setbeamerfont{institute}{size=\normalsize}
\setbeamerfont{frametitle}{size=\Large}
\setbeamerfont{footline}{size=\tiny}
\pgfdeclareimage[height=5mm]{cgi@logo}{logos/hpi_logo_cmyk_b}

\setbeamersize{text margin left=8mm,text margin right=8mm}

\renewcommand\thempfootnote{\arabic{mpfootnote}}
\newcommand{\blueify}[1]{\textcolor{CorporateBlue2}{#1}}
\newcommand{\grayify}[1]{\textcolor{gray}{#1}}

\defbeamertemplate*{title page}{cgi}[1][]
{
	\center
	\usebeamerfont{title}\usebeamercolor[fg]{title}
	\inserttitle\par
	\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}
	\ifx\insertsubtitle\empty
	\else
		\medskip\insertsubtitle\par
	\fi
	\bigskip
	\inserttitlegraphic\par
	\usebeamerfont{author}\usebeamercolor[fg]{author}
	\ifx\insertauthor\empty
	\else
		\bigskip\insertauthor\par
	\fi
	\usebeamerfont{institute}\usebeamercolor[fg]{institute}
	\ifx\insertinstitute\empty
	\else
		\smallskip\insertinstitute\par
	\fi
}

\defbeamertemplate*{frametitle}{cgi}
{
	\begin{beamercolorbox}[left, leftskip=8mm, ht=8mm, dp=1mm, wd=\paperwidth]{frametitle}
		\usebeamerfont{frametitle}\insertframetitle{}
	\end{beamercolorbox}
	\nointerlineskip
	\vspace{-16mm}
	\begin{beamercolorbox}[right, rightskip=8mm, ht=16mm, dp=1mm, wd=\paperwidth]{}
		\pgfuseimage{cgi@logo}
	\end{beamercolorbox}
	\vspace{-2mm}
}

\defbeamertemplate*{footline}{cgi}
{
	\begin{beamercolorbox}[left, leftskip=8mm, rightskip=8mm, dp=4mm, wd=\paperwidth]{footline}
		\insertpagenumber \quad \insertshorttitle:~\insertshortsubtitle %
		\hfill \insertauthor | iV2017 London \quad 2017-07-12%
	\end{beamercolorbox}%
}

\setbeamertemplate{navigation symbols}{}

\setbeamertemplate{itemize items}[circle]
\setbeamercolor{itemize item}{fg=black}
\setbeamercolor{itemize subitem}{fg=black}
\setbeamercolor{item projected}{bg=black}
\setbeamertemplate{enumerate items}[box]
\setbeamertemplate{section in toc}{\inserttocsectionnumber.~\inserttocsection}

